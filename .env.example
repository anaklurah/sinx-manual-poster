# Sin'X Manual Poster Environment Variables
HOST_PORT=8090
TIMEZONE=Asia/Jakarta

# Database & Paths
POSTER_DB_PATH=./data/manual_poster.db
UPLOADS_DIR=./uploads
PROFILES_DIR=./assets/profiles

# Browser Mode (set false jika ingin melihat jendela browser Playwright saat testing lokal)
HEADLESS=true
BROWSER_ENGINE=camoufox

# Proxy opsional (HTTP/HTTPS/SOCKS5)
PROXY_URL=

# Telegram Bot Alerts
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
